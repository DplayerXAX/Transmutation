// Generated by ArtFormationSetup. Only the comparison board uses this palette mapping.
#ifndef ART_FORMATION_PALETTE_INCLUDED
#define ART_FORMATION_PALETTE_INCLUDED
half4 ArtFormationColor(half4 source, half4 palette)
{
    // Remove every source hue, including vertex colors and code-generated rainbows.
    // Keep the pattern's brightness, HDR range, alpha, and animation.
    half value = max(0.0h, dot(source.rgb, half3(0.2126h, 0.7152h, 0.0722h)));
    return half4(value * palette.rgb, source.a);
}
#endif
